<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Arguments (externally settable) -->
  <xacro:arg name="serial_port"            default="/dev/ttySERVO"/>
  <xacro:arg name="baud_rate"              default="1000000"/>
  <xacro:arg name="use_mock"               default="false"/>
  <xacro:arg name="use_sync_write"         default="true"/>
  <xacro:arg name="pan_motor_id"           default="1"/>
  <xacro:arg name="tilt_motor_id"          default="2"/>
  <xacro:arg name="pan_center_steps"       default="2048"/>
  <xacro:arg name="tilt_center_steps"      default="2646"/>
  <xacro:arg name="sts_max_velocity_steps" default="3400"/>   <!-- STS3215=3400, STS3032=2900, STS3235=3400 -->
  <xacro:arg name="proportional_vel_max"   default="0"/>      <!-- [0-max_velocity_steps]; 0 = each joint uses commanded velocity -->
  <xacro:arg name="pan_joint_lower"        default="-1.5708"/>  <!-- rad, default -π/2 -->
  <xacro:arg name="pan_joint_upper"        default="1.5708"/>   <!-- rad, default +π/2 -->
  <xacro:arg name="tilt_joint_lower"       default="-1.5708"/>  <!-- rad, default -π/2 -->
  <xacro:arg name="tilt_joint_upper"       default="1.5708"/>   <!-- rad, default +π/2 -->

  <!-- Simulation -->
  <!-- "real" (default) keeps the STS3215 serial hardware plugin below unchanged.
       "gazebo" swaps the <hardware> plugin for gz_ros2_control/GazeboSimSystem.
       "mujoco" swaps it for mujoco_ros2_control/MujocoSystemInterface.
       Both implement the same SystemInterface contract - the joints and controllers stay
       identical in all three cases. -->
  <xacro:arg name="ros2_control_hardware_type" default="real"/>
  <!-- Path to the controllers YAML the embedded controller_manager should load; only
       used when the <gazebo> plugin below is actually instantiated (i.e. in sim). -->
  <xacro:arg name="simulation_controllers" default=""/>
  <!-- mujoco mode only: path to the xacro-generated MJCF scene (pt_description/mjcf/
       pantilt.mjcf.xacro, xacro-processed at launch time with pantilt_config picking the
       pt100/pt101 mesh variant - see pt_control/launch/pantilt.launch.py) and whether to
       open the MuJoCo Simulate viewer window. -->
  <xacro:arg name="mujoco_model" default=""/>
  <xacro:arg name="mujoco_headless" default="false"/>

  <!-- Hardware velocity ceiling — defined before <ros2_control> because the hardware
       plugin param references it directly. pantilt_joints receives the same value so
       joint velocity limits stay consistent with what the interface is configured to enforce. -->
  <xacro:property name="sts_max_velocity_steps" value="$(arg sts_max_velocity_steps)"/>

  <!-- Torque/velocity limits and joint limits as top-level properties — required by
       pantilt.module.xacro for the URDF <limit> elements on the revolute joints.
       pantilt_max_velocity_rads duplicates pantilt_joints' own local computation
       (pantilt.joints.xacro) - only used by module.xacro's gazebo-mode <limit velocity>,
       real mode keeps velocity="1e6" (see module.xacro's comment on why) regardless. -->
  <!-- 19.5 kgf*cm stall torque @ 7.4V per Feetech's STS3215-C001 datasheet (the SO-ARM100/101
       variant this project uses, per pantilt_shared.xml's "matches so_arm100" comment) - not
       the 30 kgf*cm figure, which belongs to a different 12V member of the ST3215 family. -->
  <xacro:property name="max_torque_nm"    value="1.9123"/>  <!-- N⋅m (19.5 kgf⋅cm @ 7.4V) -->
  <xacro:property name="pantilt_max_velocity_steps" value="${int(sts_max_velocity_steps * 0.85)}"/>
  <xacro:property name="pantilt_max_velocity_rads"  value="${pantilt_max_velocity_steps * 2 * pi / 4096}"/>
  <xacro:property name="pan_joint_lower"  value="$(arg pan_joint_lower)"/>
  <xacro:property name="pan_joint_upper"  value="$(arg pan_joint_upper)"/>
  <xacro:property name="tilt_joint_lower" value="$(arg tilt_joint_lower)"/>
  <xacro:property name="tilt_joint_upper" value="$(arg tilt_joint_upper)"/>

  <xacro:include filename="$(find pt_description)/urdf/pantilt.joints.xacro"/>

  <!-- ROS 2 CONTROL -->
  <ros2_control name="pantilt_control" type="system">
    <hardware>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gazebo'}">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mujoco'}">
        <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
        <param name="mujoco_model">$(arg mujoco_model)</param>
        <param name="headless">$(arg mujoco_headless)</param>
      </xacro:if>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
        <plugin>sts_hardware_interface/STSHardwareInterface</plugin>
        <param name="serial_port">$(arg serial_port)</param>
        <param name="baud_rate">$(arg baud_rate)</param>
        <param name="communication_timeout_ms">100</param>
        <param name="use_sync_write">$(arg use_sync_write)</param>
        <param name="enable_mock_mode">$(arg use_mock)</param>
        <param name="max_velocity_steps">${sts_max_velocity_steps}</param>
        <param name="proportional_vel_max">$(arg proportional_vel_max)</param>
        <param name="reset_states_on_activate">true</param>
      </xacro:if>
    </hardware>

    <xacro:pantilt_joints
        pan_motor_id="$(arg pan_motor_id)"
        tilt_motor_id="$(arg tilt_motor_id)"
        pan_center_steps="$(arg pan_center_steps)"
        tilt_center_steps="$(arg tilt_center_steps)"
        sts_max_velocity_steps="${sts_max_velocity_steps}"
        pan_joint_lower="${pan_joint_lower}"
        pan_joint_upper="${pan_joint_upper}"
        tilt_joint_lower="${tilt_joint_lower}"
        tilt_joint_upper="${tilt_joint_upper}"
        ros2_control_hardware_type="$(arg ros2_control_hardware_type)"/>
  </ros2_control>

</robot>
